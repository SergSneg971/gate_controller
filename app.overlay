/ {
    aliases {
        led0 = &blue_led;
        sw0 = &pair_btn;
        relay-full = &relay_1;
        relay-wicket = &relay_2;
        reed-switch = &reed_1;
    };

    leds {
        compatible = "gpio-leds";
        blue_led: led_0 {
            /* Встроенный LED на SuperMini nRF52840 */
            gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>;
        };
        relay_1: relay_full {
            /* Реле 1: Полное открытие (пин 017) */
            gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>;
        };
        relay_2: relay_wicket {
            /* Реле 2: Калитка (пин 020) */
            gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
        };
        ext_vcc: vcc_en {
            /* Включает питание 3.3V на пине VCC платы */
            gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
        };
    };

    buttons {
        compatible = "gpio-keys";
        pair_btn: button_0 {
            /* Кнопка сброса сети перенесена на пин 011 (5 сек на GND) */
            gpios = <&gpio0 11 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
        };
        reed_1: reed_closed {
            /* Геркон полного закрытия (пин 022, замкнут на GND при закрытых воротах) */
            gpios = <&gpio0 22 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
        };
    };
};

&spi1 {
    status = "disabled";
};
