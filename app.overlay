/ {
    aliases {
        led0 = &blue_led;
        sw0 = &pair_btn;
        relay-full = &relay_1;
        relay-wicket = &relay_2;
        reed-switch = &reed_1;
    };

    leds {
        compatible = "gpio-leds";
        blue_led: led_0 {
            /* Встроенный синий LED на SuperMini nRF52840 */
            gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>;
        };
        relay_1: relay_full {
            /* Реле 1: Полное открытие (поменяйте на GPIO_ACTIVE_LOW, если реле срабатывает от 0) */
            gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>;
        };
        relay_2: relay_wicket {
            /* Реле 2: Калитка */
            gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
        };
    };

    buttons {
        compatible = "gpio-keys";
        pair_btn: button_0 {
            /* Кнопка сброса сети (5 сек на GND) */
            gpios = <&gpio0 13 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
        };
        reed_1: reed_closed {
            /* Геркон полного закрытия (замкнут на GND при закрытых воротах) */
            gpios = <&gpio0 22 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
        };
    };
};

/* Отключаем SPI/DotStar, которые включены по умолчанию в профиль ItsyBitsy, чтобы освободить пины */
&spi1 {
    status = "disabled";
};
